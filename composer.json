{
  "name": "sugarcommerce/stripe",
  "version": "1.3.0",
  "description": "A small Stripe client for Connect platforms: pinned API version, Stripe-Account per request, a fetch that throws instead of answering null, signed event parsing with payload redaction, and readers for the fields Stripe moves between API versions.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/stripe",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["stripe", "connect", "payments", "webhooks", "api-client"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/http-client": "^1.2",
    "sugarcommerce/webhooks": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Stripe\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Stripe\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/stripe/issues", "source": "https://github.com/sugarcommerce/stripe" }
}
